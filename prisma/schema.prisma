generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceType {
  PRIVATE
  TEAM
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum InterfaceMode {
  LIGHT
  DARK
}

enum ThemePalette {
  ORIGINAL
  SAPPHIRE
  OCEAN
  FOREST
  SUNSET
  CUSTOM
}

enum InboxNotificationType {
  WORKSPACE_INVITATION
  WORKSPACE_MEMBER_JOINED
  WORKSPACE_MEMBER_REMOVED
  WORKSPACE_ROLE_CHANGED
  VIDEO_EXPORT_COMPLETED
  VIDEO_EXPORT_FAILED
  CREDITS_PLATFORM_GRANT
  CREDITS_PLATFORM_REVOKE
  CREDITS_WORKSPACE_GRANT
  CREDITS_ALLOCATED
  CREDITS_DEALLOCATED
  CREDITS_LOW_PERSONAL
  CREDITS_LOW_WORKSPACE
  STORAGE_PLATFORM_GRANT
  STORAGE_PLATFORM_REVOKE
  STORAGE_THRESHOLD_WARNING
  STORAGE_UPLOAD_BLOCKED
  STORAGE_UPGRADE_REJECTED
  PLATFORM_HEYGEN_WALLET_LOW
  PLATFORM_STORAGE_UPGRADE_REQUEST
  CREDITS_WORKSPACE_REVOKE
  PROJECT_COMMENT_ADDED
  PROJECT_COMMENT_MENTION
  PLATFORM_EARLY_ACCESS_REQUEST
  PRESENTATION_EXPORT_COMPLETED
  PRESENTATION_EXPORT_FAILED
  PRESENTATION_GENERATION_COMPLETED
  PRESENTATION_GENERATION_FAILED
  PRESENTATION_COMMENT_ADDED
  PRESENTATION_COMMENT_MENTION
}

enum EarlyAccessRequestStatus {
  PENDING
  UNDER_REVIEW
  IN_DISCUSSION
  APPROVED
  REJECTED
}

enum ProjectType {
  VIDEO
  PRESENTATION
}

enum PresentationShareRole {
  VIEWER
  REVIEWER
}

/// Editor-set slide progress for reviewers (not generation status).
enum SlideProgressStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum TemplateType {
  VIDEO_SCENE
  DECK_LAYOUT
  DECK_PACK
  VIDEO_PACK
}

enum StorageUpgradeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductEmailBroadcastRecipientStatus {
  SENT
  FAILED
}

model User {
  id            String  @id @default(uuid())
  email         String  @unique
  name          String?
  password      String?
  profileImage  String? @map("profile_image")
  phoneNumber   String? @map("phone_number")
  emailVerified Boolean @default(false) @map("email_verified")
  storageLimit  BigInt  @default(1073741824) // 1 GB default limit
  storageUsed   BigInt  @default(0)
  credits             Int     @default(0)
  isPlatformSuperadmin Boolean @default(false) @map("is_platform_superadmin")

  deletionRequestedAt DateTime? @map("deletion_requested_at")
  deletionScheduledAt DateTime? @map("deletion_scheduled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  accounts            Account[]
  sessions            Session[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  creditTransactions  CreditTransaction[]
  storageTransactions StorageTransaction[]
  uploadedAssets      Asset[]              @relation("AssetUploader")
  imageGenerations    ImageGeneration[]
  imageGenContexts    ImageGenContext[]
  imageGenThreads     ImageGenThread[]
  imageGenMessages    ImageGenMessage[]

  ownedWorkspaces      Workspace[]       @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]

  heygenAvatars HeygenAvatar[]
  heygenVoices  HeygenVoice[]
  heygenWorkspaceShares HeygenWorkspaceShare[] @relation("HeygenWorkspaceShareSharedBy")

  settings UserSettings?
  inboxNotifications UserInboxNotification[]
  storageUpgradeRequests StorageUpgradeRequest[]
  projectComments ProjectComment[] @relation("ProjectCommentAuthor")
  presentationComments PresentationComment[] @relation("PresentationCommentAuthor")
  sentInvitations Invitation[] @relation("InvitationInvitedBy")
  productEmailBroadcastsSent ProductEmailBroadcast[] @relation("ProductEmailBroadcastSentBy")
  productEmailBroadcastRecipients ProductEmailBroadcastRecipient[]
  presentationShareLinks  PresentationShareLink[]  @relation("PresentationShareCreatedBy")
  presentationShareAudits PresentationShareAudit[] @relation("PresentationShareAuditActor")

  @@index([deletionScheduledAt])
  @@map("users")
}

model UserSettings {
  id                String         @id @default(uuid())
  userId            String         @unique @map("user_id")
  interfaceMode         InterfaceMode @default(LIGHT) @map("interface_mode")
  themePalette          ThemePalette  @default(SAPPHIRE) @map("theme_palette")
  customAccentColor     String        @default("#2563EB") @map("custom_accent_color")
  pushNotifications            Boolean @default(true) @map("push_notifications")
  commentsAndMentions          Boolean @default(true) @map("comments_and_mentions")
  weeklyDigestEmail            Boolean @default(false) @map("weekly_digest_email")
  productEmails                Boolean @default(false) @map("product_emails")
  videoExportAlerts            Boolean @default(true) @map("video_export_alerts")
  workspaceVideoExportAlerts   Boolean @default(true) @map("workspace_video_export_alerts")
  creditsAlerts                Boolean @default(true) @map("credits_alerts")
  storageAlerts                Boolean @default(true) @map("storage_alerts")
  workspaceTeamAlerts          Boolean @default(true) @map("workspace_team_alerts")
  platformAdminAlerts          Boolean @default(true) @map("platform_admin_alerts")
  loginAlerts                  Boolean @default(true) @map("login_alerts")
  lastWeeklyDigestSentAt       DateTime? @map("last_weekly_digest_sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_settings")
}

model Workspace {
  id        String        @id @default(uuid())
  name      String
  type      WorkspaceType
  ownerId   String        @map("owner_id")
  credits   Int           @default(0)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  invitations Invitation[]

  folders           Folder[]
  projects          Project[]
  assets            Asset[]
  heygenResponses    HeygenResponse[]
  speechGenerations  SpeechGeneration[]
  projectRenders     ProjectRender[]
  sceneRenderCaches  SceneRenderCache[]
  heygenWorkspaceShares HeygenWorkspaceShare[]
  projectComments    ProjectComment[]
  presentationComments PresentationComment[]
  imageGenerations   ImageGeneration[]
  imageGenContexts   ImageGenContext[]
  imageGenThreads    ImageGenThread[]
  brandKits          WorkspaceBrandKit[]
  presentationShareLinks PresentationShareLink[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole
  joinedAt    DateTime      @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

model Invitation {
  id          String           @id @default(uuid())
  workspaceId String           @map("workspace_id")
  email       String
  role        WorkspaceRole
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String?          @map("invited_by_id")
  expiresAt   DateTime         @map("expires_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([email])
  @@index([token])
  @@index([expiresAt])
  @@index([invitedById])
  @@map("invitations")
}

model UserInboxNotification {
  id           String                @id @default(uuid())
  userId       String                @map("user_id")
  type         InboxNotificationType
  title        String
  message      String
  readAt       DateTime?             @map("read_at")
  metadata     Json?
  invitationId String?               @map("invitation_id")
  workspaceId  String?               @map("workspace_id")
  referenceId  String?               @map("reference_id")
  createdAt    DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, invitationId])
  @@unique([userId, type, referenceId])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([userId, workspaceId])
  @@map("user_inbox_notifications")
}

model Account {
  id     String @id @default(uuid())
  userId String @map("user_id")

  type              String
  provider          String
  providerAccountId String @map("provider_account_id")

  refreshToken String? @map("refresh_token")
  accessToken  String? @map("access_token")
  expiresAt    Int?    @map("expires_at")
  tokenType    String? @map("token_type")
  scope        String?
  idToken      String? @map("id_token")
  sessionState String? @map("session_state")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expiresAt    DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id          String @id @default(uuid())
  hashedToken String @unique @map("hashed_token")
  userId      String @map("user_id")
  sessionId   String @map("session_id")

  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model CreditTransaction {
  id             String   @id @default(uuid())
  userId         String
  workspaceId    String?
  amount         Int
  type           String // usage | platform_grant | platform_revoke | allocation | deallocation | refund | purchase
  scope          String? // user | workspace
  reference      String?
  idempotencyKey String?  @unique
  metadata       Json?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([workspaceId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@index([scope])
  @@map("credit_transactions")
}

model StorageTransaction {
  id          String   @id @default(uuid())
  userId      String
  amountBytes BigInt   @map("amount_bytes")
  type        String // initial | platform_grant | platform_revoke | purchase
  tierId      String?  @map("tier_id")
  reference   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type])
  @@map("storage_transactions")
}

model StorageUpgradeRequest {
  id                        String                      @id @default(uuid())
  userId                    String                      @map("user_id")
  requestedAdditionalGb     Int                         @map("requested_additional_gb")
  requestedAdditionalBytes    BigInt                      @map("requested_additional_bytes")
  reason                    String
  urgency                   String
  currentUsedBytes          BigInt                      @map("current_used_bytes")
  currentLimitBytes         BigInt                      @map("current_limit_bytes")
  tierId                    String?                     @map("tier_id")
  tierLabel                 String?                     @map("tier_label")
  workspaceId               String?                     @map("workspace_id")
  workspaceName             String?                     @map("workspace_name")
  workspaceFootprintBytes   BigInt?                     @map("workspace_footprint_bytes")
  status                    StorageUpgradeRequestStatus @default(PENDING)
  reviewedAt                DateTime?                   @map("reviewed_at")
  reviewedByUserId          String?                     @map("reviewed_by_user_id")
  reviewNote                String?                     @map("review_note")
  createdAt                 DateTime                    @default(now()) @map("created_at")
  updatedAt                 DateTime                    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
  @@map("storage_upgrade_requests")
}

model Folder {
  id          String    @id @default(uuid())
  name        String
  workspaceId String
  createdBy   String
  updatedBy   String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects    Project[]
  imageGenThreads ImageGenThread[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([name, workspaceId]) // prevent duplicate folder names in same workspace
  @@index([updatedBy])
}

model Project {
  id          String @id @default(uuid())
  name        String
  workspaceId String
  folderId    String
  createdBy   String
  updatedBy   String?

  type          ProjectType @default(VIDEO)
  data          Json // 🔥 whole editor state (autosave)
  thumbnail     String? // preview image
  duration      Int? // optional
  status        String  @default("draft") // draft | rendering | completed
  storageBytes  BigInt  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder            Folder             @relation(fields: [folderId], references: [id], onDelete: Cascade)
  heygenResponses    HeygenResponse[]
  speechGenerations  SpeechGeneration[]
  projectRenders     ProjectRender[]
  sceneRenderCaches  SceneRenderCache[]
  comments           ProjectComment[]
  presentationComments PresentationComment[]
  deck               Deck?
  shareLinks         PresentationShareLink[]

  @@index([updatedBy])
  @@index([type])
}

model ProjectComment {
  id               String    @id @default(uuid())
  workspaceId      String    @map("workspace_id")
  projectId        String    @map("project_id")
  authorId         String    @map("author_id")
  body             String
  mentionedUserIds String[]  @map("mentioned_user_ids")
  /// Null for a root thread; set for a reply. Only one level of nesting is allowed.
  parentId         String?   @map("parent_id")
  /// Roots only. Workspace members resolve / reopen, same as presentation comments.
  resolvedAt       DateTime? @map("resolved_at")
  resolvedBy       String?   @map("resolved_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User      @relation("ProjectCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent    ProjectComment?  @relation("ProjectCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ProjectComment[] @relation("ProjectCommentReplies")

  @@index([projectId, createdAt])
  @@index([workspaceId])
  @@index([parentId])
  @@map("project_comments")
}

model Asset {
  id          String @id @default(uuid())
  workspaceId String
  uploadedBy  String

  name String @default("untitled")

  size BigInt
  type String

  url String
  key String

  source          String @default("upload") // upload | stock | ai_gen
  stockProvider   String?
  stockExternalId String?
  stockMetadata   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploader         User              @relation("AssetUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)
  imageGenerations ImageGeneration[]

  @@unique([workspaceId, stockProvider, stockExternalId])
  @@index([workspaceId, uploadedBy])
}

model ImageGenContext {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  userId      String    @map("user_id")
  status      String    @default("READY")
  inlineText  String?   @map("inline_text") @db.Text
  derived     Json
  expiresAt   DateTime  @map("expires_at")
  pinnedAt    DateTime? @map("pinned_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  files       ImageGenContextFile[]
  generations ImageGeneration[]
  threads     ImageGenThread[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, userId])
  @@index([expiresAt])
  @@map("image_gen_contexts")
}

model ImageGenContextFile {
  id            String  @id @default(uuid())
  contextId     String  @map("context_id")
  source        String // upload | asset
  assetId       String? @map("asset_id")
  name          String
  mimeType      String  @map("mime_type")
  s3Key         String  @map("s3_key")
  role          String // document | reference_image
  extractedText String? @map("extracted_text") @db.Text
  imageSummary  String? @map("image_summary") @db.Text

  context ImageGenContext @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@index([contextId])
  @@map("image_gen_context_files")
}

model ImageGenThread {
  id                 String   @id @default(uuid())
  workspaceId        String   @map("workspace_id")
  folderId           String   @map("folder_id")
  userId             String   @map("user_id")
  title              String
  rootGenerationId   String   @map("root_generation_id")
  headGenerationId   String   @map("head_generation_id")
  contextId          String?  @map("context_id")
  modelId            String?  @map("model_id")
  formatId           String?  @map("format_id")
  styleId            String?  @map("style_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder         Folder           @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  context        ImageGenContext? @relation(fields: [contextId], references: [id], onDelete: SetNull)
  rootGeneration ImageGeneration  @relation("ThreadRoot", fields: [rootGenerationId], references: [id], onDelete: Restrict)
  headGeneration ImageGeneration  @relation("ThreadHead", fields: [headGenerationId], references: [id], onDelete: Restrict)
  generations    ImageGeneration[] @relation("ThreadHops")
  messages       ImageGenMessage[]

  @@unique([rootGenerationId])
  @@index([workspaceId, folderId, updatedAt])
  @@index([workspaceId, userId])
  @@index([folderId])
  @@index([headGenerationId])
  @@index([contextId])
  @@map("image_gen_threads")
}

model ImageGenMessage {
  id             String   @id @default(uuid())
  threadId       String   @map("thread_id")
  userId         String   @map("user_id")
  role           String
  type           String
  content        String   @db.Text
  generationId   String?  @map("generation_id")
  creditsCharged Int      @default(0) @map("credits_charged")
  createdAt      DateTime @default(now()) @map("created_at")

  thread     ImageGenThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation ImageGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@index([generationId])
  @@map("image_gen_messages")
}

model ImageGeneration {
  id             String  @id @default(uuid())
  workspaceId    String  @map("workspace_id")
  userId         String  @map("user_id")
  mode           String
  modelId        String  @map("model_id")
  formatId       String? @map("format_id")
  styleId        String? @map("style_id")
  prompt         String  @db.Text
  revisedPrompt  String? @map("revised_prompt") @db.Text
  request        Json?
  parentId       String? @map("parent_id")
  rootId         String? @map("root_id")
  action         String
  assetId        String? @map("asset_id")
  contextId      String? @map("context_id")
  threadId       String? @map("thread_id")
  s3Key          String  @map("s3_key")
  url            String
  openaiSize     String? @map("openai_size")
  exportWidth    Int?    @map("export_width")
  exportHeight   Int?    @map("export_height")
  creditsCharged Int     @default(0) @map("credits_charged")
  status         String  @default("SUCCEEDED")
  createdAt      DateTime @default(now()) @map("created_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset     Asset?           @relation(fields: [assetId], references: [id], onDelete: SetNull)
  context   ImageGenContext? @relation(fields: [contextId], references: [id], onDelete: SetNull)
  thread    ImageGenThread?  @relation("ThreadHops", fields: [threadId], references: [id], onDelete: SetNull)
  parent    ImageGeneration? @relation("ImageGenChain", fields: [parentId], references: [id], onDelete: SetNull)
  children  ImageGeneration[] @relation("ImageGenChain")
  messages  ImageGenMessage[]
  threadRootFor ImageGenThread[] @relation("ThreadRoot")
  threadHeadFor ImageGenThread[] @relation("ThreadHead")

  @@index([workspaceId, createdAt])
  @@index([workspaceId, userId])
  @@index([rootId])
  @@index([assetId])
  @@index([contextId])
  @@index([threadId])
  @@map("image_generations")
}

model HeygenResponse {
  id          String  @id @default(uuid())
  workspaceId String
  folderId    String?
  projectId   String
  sceneId     String  @default("") // client scene key from editor; required on new creates (validated in API)
  videoId     String
  videoUrl    String
  s3Key         String? // S3 object key after upload; used for presigned GET
  fileSizeBytes BigInt?
  requestHash   String  @unique
  status        String  @default("processing") // processing | completed | failed
  rawResponse   Json?
  triggeredByUserId String? @map("triggered_by_user_id")
  creditsCharged    Int?    @map("credits_charged")
  billedDurationSec Float?  @map("billed_duration_sec")
  billingStatus     String  @default("pending") @map("billing_status") // pending | charged | failed | skipped
  billingContext    Json?   @map("billing_context")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, workspaceId])
}

model SpeechGeneration {
  id                String   @id @default(uuid())
  workspaceId       String
  folderId          String?
  projectId         String
  sceneId           String   @default("")
  voiceId           String
  script            String
  inputType         String   @default("text")
  speed             Float    @default(1)
  locale            String?
  language          String?
  heygenAudioUrl    String?
  audioUrl          String   @default("")
  s3Key             String?
  fileSizeBytes     BigInt?
  durationSec       Float?
  wordTimestamps    Json?
  requestHash       String   @unique
  status            String   @default("completed")
  rawResponse       Json?
  triggeredByUserId String?  @map("triggered_by_user_id")
  creditsCharged    Int?     @map("credits_charged")
  billedDurationSec Float?   @map("billed_duration_sec")
  billingStatus     String   @default("pending") @map("billing_status")
  billingContext    Json?    @map("billing_context")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, workspaceId])
}

model ProjectRender {
  id            String    @id @default(uuid())
  workspaceId   String
  folderId      String
  projectId     String
  triggeredBy   String?
  status        String    @default("queued")
  progress      Int       @default(0)
  s3Key         String?
  fileSizeBytes BigInt?
  outputUrl     String?
  inputSnapshot Json?
  sceneHashes   Json?
  error         String?
  creditsCharged    Int?    @map("credits_charged")
  billedDurationSec Float?  @map("billed_duration_sec")
  billingStatus     String  @default("pending") @map("billing_status")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  startedAt     DateTime?
  completedAt   DateTime?
  failedAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, projectId])
  @@index([workspaceId, status, completedAt])
  @@map("project_renders")
}

model SceneRenderCache {
  id          String   @id @default(uuid())
  workspaceId String
  folderId    String
  projectId   String
  sceneId     String
  sceneHash   String
  s3Key         String
  fileSizeBytes BigInt?
  outputUrl     String
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sceneId, sceneHash])
  @@index([workspaceId, projectId])
  @@map("scene_render_caches")
}

