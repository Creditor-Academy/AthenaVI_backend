}

model EarlyAccessRequest {
  id         String                   @id @db.VarChar(20)
  name       String                   @db.VarChar(100)
  email      String                   @unique @db.VarChar(254)
  company    String?                  @db.VarChar(150)
  role       String?                  @db.VarChar(100)
  useCase    String?                  @map("use_case") @db.VarChar(100)
  message    String?                  @db.Text
  status     EarlyAccessRequestStatus @default(PENDING)
  createdAt  DateTime                 @default(now()) @map("created_at")
  reviewedAt DateTime?                @map("reviewed_at")
  reviewerId String?                  @map("reviewer_id") @db.VarChar(50)

  @@index([status, createdAt])
  @@map("early_access_requests")
}

model Deck {
  id                  String   @id @default(cuid())
  projectId           String   @unique
  themeTokens         Json
  outline             Json?
  status              String   @default("DRAFT") // DRAFT | GENERATING | READY | FAILED
  aspectRatio         String   @default("16:9")
  locale              String   @default("en")
  promptBundleVersion String?
  generationMetrics   Json?
  partial             Boolean  @default(false)
  creditsChargedSoFar Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slides  Slide[]
  exports DeckExport[]

  @@index([status])
  @@map("decks")
}

model Slide {
  id             String              @id @default(cuid())
  deckId         String
  order          Int
  contentType    String?
  layoutId       String?
  content        Json?
  imageRef       Json?
  /// Freeform canvas: { version, canvas: { width, height }, elements: [...] }
  elements       Json?
  status         String              @default("PENDING") // PENDING | GENERATING | READY | FAILED
  /// Editor workflow progress for reviewers. Null = no status. Not generation status.
  progressStatus SlideProgressStatus? @map("progress_status")
  /// Dashboard / My Work JPEG snapshot of the rendered canvas (not a photo on the slide).
  previewS3Key   String?             @map("preview_s3_key")
  /// sha256 of elements + themeTokens + aspectRatio — skip re-raster when unchanged.
  previewHash    String?             @map("preview_hash")
  /// PENDING | READY | FAILED — null = never generated (treat as PENDING on GET).
  previewStatus  String?             @map("preview_status")
  manuallyEdited Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  deck     Deck                  @relation(fields: [deckId], references: [id], onDelete: Cascade)
  jobs     SlideGenerationJob[]
  comments PresentationComment[]

  @@index([deckId, order])
  @@map("slides")
}

/// Slide-threaded comments on a PRESENTATION project. Authored either by a workspace member
/// (`authorId`) or by a named guest arriving through a `/p/:token` share link
/// (`guestSessionId` + `guestDisplayName`) — exactly one of the two, enforced in the service.
model PresentationComment {
  id               String    @id @default(uuid())
  projectId        String    @map("project_id")
  workspaceId      String    @map("workspace_id")
  /// Null once the slide is gone (full regenerate / manual delete): the thread is orphaned,
  /// visible in the editor only. Never cascade — that would wipe every comment on regenerate.
  slideId          String?   @map("slide_id")
  /// Null for a root thread; set for a reply. Only one level of nesting is allowed.
  parentId         String?   @map("parent_id")
  authorId         String?   @map("author_id")
  guestSessionId   String?   @map("guest_session_id")
  guestDisplayName String?   @map("guest_display_name")
  body             String
  mentionedUserIds String[]  @map("mentioned_user_ids")
  /// Roots only. Members resolve; guests cannot.
  resolvedAt       DateTime? @map("resolved_at")
  resolvedBy       String?   @map("resolved_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slide     Slide?                @relation(fields: [slideId], references: [id], onDelete: SetNull)
  parent    PresentationComment?  @relation("PresentationCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PresentationComment[] @relation("PresentationCommentReplies")
  author    User?                 @relation("PresentationCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([projectId, slideId, createdAt])
  @@index([parentId])
  @@index([workspaceId])
  @@index([guestSessionId])
  @@map("presentation_comments")
}

model Template {
  id          String       @id @default(cuid())
  type        TemplateType
  name        String
  contentType String?
  variant     String?
  schema      Json
  version     Int          @default(1)
  isActive    Boolean      @default(true)
  createdBy   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  media TemplateMedia[]

  @@index([type, contentType, isActive])
  @@map("templates")
}

model TemplateMedia {
  id        String   @id @default(cuid())
  templateId String  @map("template_id")
  kind      String // photo | preview | graphic
  slotHint  String?  @map("slot_hint") // e.g. slide:1 | image | preview
  name      String?
  s3Key     String   @map("s3_key")
  mimeType  String?  @map("mime_type")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, slotHint])
  @@index([templateId, kind])
  @@map("template_media")
}

enum GraphicType {
  decorative
  illustration
  icon
  abstract
  pattern
}

enum GraphicColorMode {
  recolorable
  fixed
}

enum GraphicStatus {
  draft
  published
  archived
}

/// Platform SVG catalog curated by Superadmin (not workspace Asset).
model GraphicAsset {
  id           String           @id @default(cuid())
  name         String
  description  String?
  fileUrl      String           @map("file_url")
  s3Key        String           @map("s3_key")
  previewUrl   String           @map("preview_url")
  previewS3Key String?          @map("preview_s3_key")
  type         GraphicType
  category     String
  tags         String[]         @default([])
  style        String?
  moods        String[]         @default([])
  usage        String[]         @default([])
  colorMode    GraphicColorMode @map("color_mode")
  containsText Boolean          @default(false) @map("contains_text")
  status       GraphicStatus    @default(draft)
  createdBy    String           @map("created_by")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([status, type])
  @@index([status, category])
  @@index([createdAt])
  @@map("graphic_asset")
}

model WorkspaceBrandKit {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  isDefault   Boolean  @default(false) @map("is_default")
  data        Json
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  media     BrandKitMedia[]

  @@index([workspaceId, isDefault])
  @@map("workspace_brand_kits")
}

model BrandKitMedia {
  id         String   @id @default(cuid())
  brandKitId String   @map("brand_kit_id")
  kind       String // logo | photo | graphic | mockup
  role       String? // logos: primary|secondary|icon|light|dark
  name       String?
  assetId    String?  @map("asset_id")
  s3Key      String   @map("s3_key")
  mimeType   String?  @map("mime_type")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  brandKit WorkspaceBrandKit @relation(fields: [brandKitId], references: [id], onDelete: Cascade)

  @@index([brandKitId, kind])
  @@map("brand_kit_media")
}

model SlideGenerationJob {
  id            String   @id @default(cuid())
  slideId       String
  jobType       String // CONTENT | IMAGE_PATH_A | IMAGE_PATH_B | VALIDATION | CLASSIFY | IMAGE_BRIEF
  status        String   @default("PENDING") // PENDING | RUNNING | SUCCEEDED | FAILED
  requestHash   String
  promptVersion String?
  model         String?
  usage         Json?
  visionScore   Float?
  error         String?
  creditCharged Boolean  @default(false)
  latencyMs     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  slide Slide @relation(fields: [slideId], references: [id], onDelete: Cascade)

  @@unique([requestHash])
  @@index([slideId, jobType])
  @@map("slide_generation_jobs")
}

model DeckExport {
  id            String   @id @default(cuid())
  deckId        String
  format        String // PPTX | PDF
  status        String   @default("QUEUED") // QUEUED | RENDERING | READY | FAILED
  s3Key         String?
  error         String?
  creditCharged Boolean  @default(false)
  creditsCharged Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@index([deckId, status])
  @@map("deck_exports")
}

model PresentationImageCache {
  id        String   @id @default(cuid())
  briefHash String   @unique
  s3Key     String
  url       String?
  source    String // stock | ai_gen | path_b
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("presentation_image_cache")
}

model PresentationShareLink {
  id          String                @id @default(uuid())
  projectId   String                @map("project_id")
  workspaceId String                @map("workspace_id")
  tokenHash   String                @unique @map("token_hash")
  /// Raw capability token for owner redisplay (GET/PATCH). Public resolve still uses tokenHash only.
  token       String?               @map("token")
  tokenPrefix String                @map("token_prefix")
  role        PresentationShareRole
  enabled     Boolean               @default(true)
  createdBy   String?               @map("created_by")
  revokedAt   DateTime?             @map("revoked_at")
  rotateCount Int                   @default(0) @map("rotate_count")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  project       Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace     Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUser User?                    @relation("PresentationShareCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  audits        PresentationShareAudit[]

  @@unique([projectId, role])
  @@index([workspaceId])
  @@index([createdBy])
  @@map("presentation_share_links")
}

model PresentationShareAudit {
  id          String   @id @default(uuid())
  shareId     String   @map("share_id")
  actorUserId String?  @map("actor_user_id")
  action      String // CREATED | ROTATED | DISABLED | ENABLED
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at")

  share PresentationShareLink @relation(fields: [shareId], references: [id], onDelete: Cascade)
  actor User?                 @relation("PresentationShareAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([shareId, createdAt])
  @@index([actorUserId])
  @@map("presentation_share_audits")
}

model ProductEmailBroadcast {
  id             String   @id @default(uuid())
  subject        String
  htmlBody       String   @map("html_body") @db.Text
  textBody       String?  @map("text_body") @db.Text
  sentByUserId   String   @map("sent_by_user_id")
  recipientCount Int      @map("recipient_count")
  sentCount      Int      @map("sent_count")
  failedCount    Int      @map("failed_count")
  createdAt      DateTime @default(now()) @map("created_at")

  sentBy     User @relation("ProductEmailBroadcastSentBy", fields: [sentByUserId], references: [id], onDelete: Restrict)
  recipients ProductEmailBroadcastRecipient[]

  @@index([createdAt])
  @@index([sentByUserId])
  @@map("product_email_broadcasts")
}

model ProductEmailBroadcastRecipient {
  id          String                               @id @default(uuid())
  broadcastId String                               @map("broadcast_id")
  userId      String                               @map("user_id")
  email       String
  name        String?
  status      ProductEmailBroadcastRecipientStatus
  error       String?
  sentAt      DateTime?                            @map("sent_at")
  createdAt   DateTime                             @default(now()) @map("created_at")

  broadcast ProductEmailBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, userId])
  @@index([broadcastId])
  @@index([userId])
  @@map("product_email_broadcast_recipients")
}
