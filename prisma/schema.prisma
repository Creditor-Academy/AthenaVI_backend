generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceType {
  PRIVATE
  TEAM
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model User {
  id            String  @id @default(uuid())
  email         String  @unique
  name          String?
  password      String?
  profileImage  String? @map("profile_image")
  phoneNumber   String? @map("phone_number")
  emailVerified Boolean @default(false) @map("email_verified")
  storageLimit  Int     @default(1073741824) // 1 GB default limit
  storageUsed   Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  accounts            Account[]
  sessions            Session[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  creditTransactions  CreditTransaction[]

  ownedWorkspaces      Workspace[]       @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]

  @@map("users")
}

model Workspace {
  id        String        @id @default(uuid())
  name      String
  type      WorkspaceType
  ownerId   String        @map("owner_id")
  credits   Int           @default(0)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  invitations Invitation[]

  folders         Folder[]
  projects        Project[]
  assets          Asset[]
  heygenResponses HeygenResponse[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole
  joinedAt    DateTime      @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

model Invitation {
  id          String           @id @default(uuid())
  workspaceId String           @map("workspace_id")
  email       String
  role        WorkspaceRole
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@index([token])
  @@index([expiresAt])
  @@map("invitations")
}

model Account {
  id     String @id @default(uuid())
  userId String @map("user_id")

  type              String
  provider          String 
  providerAccountId String @map("provider_account_id")

  refreshToken String? @map("refresh_token")
  accessToken  String? @map("access_token")
  expiresAt    Int?    @map("expires_at")
  tokenType    String? @map("token_type")
  scope        String?
  idToken      String? @map("id_token")
  sessionState String? @map("session_state")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expiresAt    DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id          String @id @default(uuid())
  hashedToken String @unique @map("hashed_token")
  userId      String @map("user_id")
  sessionId   String @map("session_id")

  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model CreditTransaction {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  amount      Int
  type        String // purchase | usage | refund | admin_adjustment
  reference   String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([workspaceId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@map("credit_transactions")
}

model Folder {
  id          String    @id @default(uuid())
  name        String
  workspaceId String
  createdBy   String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  projects    Project[]
  createdAt   DateTime  @default(now())

  @@unique([name, workspaceId]) // prevent duplicate folder names in same workspace
}

model Project {
  id          String @id @default(uuid())
  name        String
  workspaceId String
  folderId    String
  createdBy   String

  data      Json // 🔥 whole editor state (autosave)
  thumbnail String? // preview image
  duration  Int? // optional
  status    String  @default("draft") // draft | rendering | completed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace       Workspace        @relation(fields: [workspaceId], references: [id])
  folder          Folder           @relation(fields: [folderId], references: [id])
  heygenResponses HeygenResponse[]
}

model Asset {
  id          String @id @default(uuid())
  workspaceId String
  uploadedBy  String

  name String @default("untitled")

  size Int
  type String

  url String
  key String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model HeygenResponse {
  id          String @id @default(uuid())
  workspaceId String
  projectId   String
  videoId     String
  videoUrl    String
  requestHash String @unique
  status      String @default("processing") // processing | completed | failed
  rawResponse Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  project   Project   @relation(fields: [projectId], references: [id])
}
