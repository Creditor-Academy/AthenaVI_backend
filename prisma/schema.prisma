generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceType {
  PRIVATE
  TEAM
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum InterfaceMode {
  LIGHT
  DARK
}

enum ThemePalette {
  ORIGINAL
  SAPPHIRE
  OCEAN
  FOREST
  SUNSET
  CUSTOM
}

enum InboxNotificationType {
  WORKSPACE_INVITATION
  WORKSPACE_MEMBER_JOINED
  WORKSPACE_MEMBER_REMOVED
  WORKSPACE_ROLE_CHANGED
  VIDEO_EXPORT_COMPLETED
  VIDEO_EXPORT_FAILED
  CREDITS_PLATFORM_GRANT
  CREDITS_PLATFORM_REVOKE
  CREDITS_WORKSPACE_GRANT
  CREDITS_ALLOCATED
  CREDITS_DEALLOCATED
  CREDITS_LOW_PERSONAL
  CREDITS_LOW_WORKSPACE
  STORAGE_PLATFORM_GRANT
  STORAGE_PLATFORM_REVOKE
  STORAGE_THRESHOLD_WARNING
  STORAGE_UPLOAD_BLOCKED
  STORAGE_UPGRADE_REJECTED
  PLATFORM_HEYGEN_WALLET_LOW
  PLATFORM_STORAGE_UPGRADE_REQUEST
  CREDITS_WORKSPACE_REVOKE
  PROJECT_COMMENT_ADDED
  PROJECT_COMMENT_MENTION
  PLATFORM_EARLY_ACCESS_REQUEST
  PRESENTATION_EXPORT_COMPLETED
  PRESENTATION_EXPORT_FAILED
  PRESENTATION_GENERATION_COMPLETED
  PRESENTATION_GENERATION_FAILED
}

enum EarlyAccessRequestStatus {
  PENDING
  UNDER_REVIEW
  IN_DISCUSSION
  APPROVED
  REJECTED
}

enum ProjectType {
  VIDEO
  PRESENTATION
}

enum TemplateType {
  VIDEO_SCENE
  DECK_LAYOUT
}

enum StorageUpgradeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductEmailBroadcastRecipientStatus {
  SENT
  FAILED
}

model User {
  id            String  @id @default(uuid())
  email         String  @unique
  name          String?
  password      String?
  profileImage  String? @map("profile_image")
  phoneNumber   String? @map("phone_number")
  emailVerified Boolean @default(false) @map("email_verified")
  storageLimit  BigInt  @default(1073741824) // 1 GB default limit
  storageUsed   BigInt  @default(0)
  credits             Int     @default(0)
  isPlatformSuperadmin Boolean @default(false) @map("is_platform_superadmin")

  deletionRequestedAt DateTime? @map("deletion_requested_at")
  deletionScheduledAt DateTime? @map("deletion_scheduled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  accounts            Account[]
  sessions            Session[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  creditTransactions  CreditTransaction[]
  storageTransactions StorageTransaction[]
  uploadedAssets      Asset[]              @relation("AssetUploader")

  ownedWorkspaces      Workspace[]       @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]

  heygenAvatars HeygenAvatar[]
  heygenVoices  HeygenVoice[]
  heygenWorkspaceShares HeygenWorkspaceShare[] @relation("HeygenWorkspaceShareSharedBy")

  settings UserSettings?
  inboxNotifications UserInboxNotification[]
  storageUpgradeRequests StorageUpgradeRequest[]
  projectComments ProjectComment[] @relation("ProjectCommentAuthor")
  sentInvitations Invitation[] @relation("InvitationInvitedBy")
  productEmailBroadcastsSent ProductEmailBroadcast[] @relation("ProductEmailBroadcastSentBy")
  productEmailBroadcastRecipients ProductEmailBroadcastRecipient[]

  @@index([deletionScheduledAt])
  @@map("users")
}

model UserSettings {
  id                String         @id @default(uuid())
  userId            String         @unique @map("user_id")
  interfaceMode         InterfaceMode @default(LIGHT) @map("interface_mode")
  themePalette          ThemePalette  @default(SAPPHIRE) @map("theme_palette")
  customAccentColor     String        @default("#2563EB") @map("custom_accent_color")
  pushNotifications            Boolean @default(true) @map("push_notifications")
  commentsAndMentions          Boolean @default(true) @map("comments_and_mentions")
  weeklyDigestEmail            Boolean @default(false) @map("weekly_digest_email")
  productEmails                Boolean @default(false) @map("product_emails")
  videoExportAlerts            Boolean @default(true) @map("video_export_alerts")
  workspaceVideoExportAlerts   Boolean @default(true) @map("workspace_video_export_alerts")
  creditsAlerts                Boolean @default(true) @map("credits_alerts")
  storageAlerts                Boolean @default(true) @map("storage_alerts")
  workspaceTeamAlerts          Boolean @default(true) @map("workspace_team_alerts")
  platformAdminAlerts          Boolean @default(true) @map("platform_admin_alerts")
  loginAlerts                  Boolean @default(true) @map("login_alerts")
  lastWeeklyDigestSentAt       DateTime? @map("last_weekly_digest_sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_settings")
}

model Workspace {
  id        String        @id @default(uuid())
  name      String
  type      WorkspaceType
  ownerId   String        @map("owner_id")
  credits   Int           @default(0)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  invitations Invitation[]

  folders           Folder[]
  projects          Project[]
  assets            Asset[]
  heygenResponses    HeygenResponse[]
  speechGenerations  SpeechGeneration[]
  projectRenders     ProjectRender[]
  sceneRenderCaches  SceneRenderCache[]
  heygenWorkspaceShares HeygenWorkspaceShare[]
  projectComments    ProjectComment[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole
  joinedAt    DateTime      @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

model Invitation {
  id          String           @id @default(uuid())
  workspaceId String           @map("workspace_id")
  email       String
  role        WorkspaceRole
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String?          @map("invited_by_id")
  expiresAt   DateTime         @map("expires_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([email])
  @@index([token])
  @@index([expiresAt])
  @@index([invitedById])
  @@map("invitations")
}

model UserInboxNotification {
  id           String                @id @default(uuid())
  userId       String                @map("user_id")
  type         InboxNotificationType
  title        String
  message      String
  readAt       DateTime?             @map("read_at")
  metadata     Json?
  invitationId String?               @map("invitation_id")
  workspaceId  String?               @map("workspace_id")
  referenceId  String?               @map("reference_id")
  createdAt    DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, invitationId])
  @@unique([userId, type, referenceId])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([userId, workspaceId])
  @@map("user_inbox_notifications")
}

model Account {
  id     String @id @default(uuid())
  userId String @map("user_id")

  type              String
  provider          String
  providerAccountId String @map("provider_account_id")

  refreshToken String? @map("refresh_token")
  accessToken  String? @map("access_token")
  expiresAt    Int?    @map("expires_at")
  tokenType    String? @map("token_type")
  scope        String?
  idToken      String? @map("id_token")
  sessionState String? @map("session_state")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expiresAt    DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id          String @id @default(uuid())
  hashedToken String @unique @map("hashed_token")
  userId      String @map("user_id")
  sessionId   String @map("session_id")

  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model CreditTransaction {
  id             String   @id @default(uuid())
  userId         String
  workspaceId    String?
  amount         Int
  type           String // usage | platform_grant | platform_revoke | allocation | deallocation | refund | purchase
  scope          String? // user | workspace
  reference      String?
  idempotencyKey String?  @unique
  metadata       Json?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([workspaceId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@index([scope])
  @@map("credit_transactions")
}

model StorageTransaction {
  id          String   @id @default(uuid())
  userId      String
  amountBytes BigInt   @map("amount_bytes")
  type        String // initial | platform_grant | platform_revoke | purchase
  tierId      String?  @map("tier_id")
  reference   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type])
  @@map("storage_transactions")
}

model StorageUpgradeRequest {
  id                        String                      @id @default(uuid())
  userId                    String                      @map("user_id")
  requestedAdditionalGb     Int                         @map("requested_additional_gb")
  requestedAdditionalBytes    BigInt                      @map("requested_additional_bytes")
  reason                    String
  urgency                   String
  currentUsedBytes          BigInt                      @map("current_used_bytes")
  currentLimitBytes         BigInt                      @map("current_limit_bytes")
  tierId                    String?                     @map("tier_id")
  tierLabel                 String?                     @map("tier_label")
  workspaceId               String?                     @map("workspace_id")
  workspaceName             String?                     @map("workspace_name")
  workspaceFootprintBytes   BigInt?                     @map("workspace_footprint_bytes")
  status                    StorageUpgradeRequestStatus @default(PENDING)
  reviewedAt                DateTime?                   @map("reviewed_at")
  reviewedByUserId          String?                     @map("reviewed_by_user_id")
  reviewNote                String?                     @map("review_note")
  createdAt                 DateTime                    @default(now()) @map("created_at")
  updatedAt                 DateTime                    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
  @@map("storage_upgrade_requests")
}

model Folder {
  id          String    @id @default(uuid())
  name        String
  workspaceId String
  createdBy   String
  updatedBy   String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([name, workspaceId]) // prevent duplicate folder names in same workspace
  @@index([updatedBy])
}

model Project {
  id          String @id @default(uuid())
  name        String
  workspaceId String
  folderId    String
  createdBy   String
  updatedBy   String?

  type          ProjectType @default(VIDEO)
  data          Json // 🔥 whole editor state (autosave)
  thumbnail     String? // preview image
  duration      Int? // optional
  status        String  @default("draft") // draft | rendering | completed
  storageBytes  BigInt  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder            Folder             @relation(fields: [folderId], references: [id], onDelete: Cascade)
  heygenResponses    HeygenResponse[]
  speechGenerations  SpeechGeneration[]
  projectRenders     ProjectRender[]
  sceneRenderCaches  SceneRenderCache[]
  comments           ProjectComment[]
  deck               Deck?

  @@index([updatedBy])
  @@index([type])
}

model ProjectComment {
  id               String    @id @default(uuid())
  workspaceId      String    @map("workspace_id")
  projectId        String    @map("project_id")
  authorId         String    @map("author_id")
  body             String
  mentionedUserIds String[]  @map("mentioned_user_ids")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User      @relation("ProjectCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([workspaceId])
  @@map("project_comments")
}

model Asset {
  id          String @id @default(uuid())
  workspaceId String
  uploadedBy  String

  name String @default("untitled")

  size BigInt
  type String

  url String
  key String

  source          String @default("upload") // upload | stock
  stockProvider   String?
  stockExternalId String?
  stockMetadata   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploader  User      @relation("AssetUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@unique([workspaceId, stockProvider, stockExternalId])
  @@index([workspaceId, uploadedBy])
}

model HeygenResponse {
  id          String  @id @default(uuid())
  workspaceId String
  folderId    String?
  projectId   String
  sceneId     String  @default("") // client scene key from editor; required on new creates (validated in API)
  videoId     String
  videoUrl    String
  s3Key         String? // S3 object key after upload; used for presigned GET
  fileSizeBytes BigInt?
  requestHash   String  @unique
  status        String  @default("processing") // processing | completed | failed
  rawResponse   Json?
  triggeredByUserId String? @map("triggered_by_user_id")
  creditsCharged    Int?    @map("credits_charged")
  billedDurationSec Float?  @map("billed_duration_sec")
  billingStatus     String  @default("pending") @map("billing_status") // pending | charged | failed | skipped
  billingContext    Json?   @map("billing_context")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, workspaceId])
}

model SpeechGeneration {
  id                String   @id @default(uuid())
  workspaceId       String
  folderId          String?
  projectId         String
  sceneId           String   @default("")
  voiceId           String
  script            String
  inputType         String   @default("text")
  speed             Float    @default(1)
  locale            String?
  language          String?
  heygenAudioUrl    String?
  audioUrl          String   @default("")
  s3Key             String?
  fileSizeBytes     BigInt?
  durationSec       Float?
  wordTimestamps    Json?
  requestHash       String   @unique
  status            String   @default("completed")
  rawResponse       Json?
  triggeredByUserId String?  @map("triggered_by_user_id")
  creditsCharged    Int?     @map("credits_charged")
  billedDurationSec Float?   @map("billed_duration_sec")
  billingStatus     String   @default("pending") @map("billing_status")
  billingContext    Json?    @map("billing_context")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, workspaceId])
}

model ProjectRender {
  id            String    @id @default(uuid())
  workspaceId   String
  folderId      String
  projectId     String
  triggeredBy   String?
  status        String    @default("queued")
  progress      Int       @default(0)
  s3Key         String?
  fileSizeBytes BigInt?
  outputUrl     String?
  inputSnapshot Json?
  sceneHashes   Json?
  error         String?
  creditsCharged    Int?    @map("credits_charged")
  billedDurationSec Float?  @map("billed_duration_sec")
  billingStatus     String  @default("pending") @map("billing_status")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  startedAt     DateTime?
  completedAt   DateTime?
  failedAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, projectId])
  @@index([workspaceId, status, completedAt])
  @@map("project_renders")
}

model SceneRenderCache {
  id          String   @id @default(uuid())
  workspaceId String
  folderId    String
  projectId   String
  sceneId     String
  sceneHash   String
  s3Key         String
  fileSizeBytes BigInt?
  outputUrl     String
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sceneId, sceneHash])
  @@index([workspaceId, projectId])
  @@map("scene_render_caches")
}

model HeygenAvatar {
  id            String  @id @default(uuid())
  userId        String  @map("user_id")
  avatarGroupId String  @map("avatar_group_id")
  avatarId      String? @map("avatar_id")
  name          String?
  type          String
  status        String  @default("processing")
  raw           Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, avatarGroupId])
  @@index([userId])
  @@index([avatarGroupId])
  @@map("heygen_avatars")
}

model HeygenVoice {
  id       String  @id @default(uuid())
  userId   String  @map("user_id")
  voiceId  String  @map("voice_id")
  name     String?
  source   String
  language String?
  raw      Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, voiceId])
  @@index([userId])
  @@index([voiceId])
  @@map("heygen_voices")
}

model HeygenWorkspaceShare {
  id             String   @id @default(uuid())
  workspaceId    String   @map("workspace_id")
  sharedByUserId String   @map("shared_by_user_id")
  resourceType   String   @map("resource_type")
  avatarGroupId  String?  @map("avatar_group_id")
  voiceId        String?  @map("voice_id")
  createdAt      DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sharedBy  User      @relation("HeygenWorkspaceShareSharedBy", fields: [sharedByUserId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, resourceType, avatarGroupId])
  @@unique([workspaceId, resourceType, voiceId])
  @@index([workspaceId])
  @@index([avatarGroupId])
  @@index([voiceId])
  @@map("heygen_workspace_shares")
}

model EarlyAccessRequest {
  id         String                   @id @db.VarChar(20)
  name       String                   @db.VarChar(100)
  email      String                   @unique @db.VarChar(254)
  company    String?                  @db.VarChar(150)
  role       String?                  @db.VarChar(100)
  useCase    String?                  @map("use_case") @db.VarChar(100)
  message    String?                  @db.Text
  status     EarlyAccessRequestStatus @default(PENDING)
  createdAt  DateTime                 @default(now()) @map("created_at")
  reviewedAt DateTime?                @map("reviewed_at")
  reviewerId String?                  @map("reviewer_id") @db.VarChar(50)

  @@index([status, createdAt])
  @@map("early_access_requests")
}

model Deck {
  id                  String   @id @default(cuid())
  projectId           String   @unique
  themeTokens         Json
  outline             Json?
  status              String   @default("DRAFT") // DRAFT | GENERATING | READY | FAILED
  aspectRatio         String   @default("16:9")
  locale              String   @default("en")
  promptBundleVersion String?
  generationMetrics   Json?
  partial             Boolean  @default(false)
  creditsChargedSoFar Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slides  Slide[]
  exports DeckExport[]

  @@index([status])
  @@map("decks")
}

model Slide {
  id             String   @id @default(cuid())
  deckId         String
  order          Int
  contentType    String?
  layoutId       String?
  content        Json?
  imageRef       Json?
  /// Freeform canvas: { version, canvas: { width, height }, elements: [...] }
  elements       Json?
  status         String   @default("PENDING") // PENDING | GENERATING | READY | FAILED
  manuallyEdited Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deck Deck                 @relation(fields: [deckId], references: [id], onDelete: Cascade)
  jobs SlideGenerationJob[]

  @@index([deckId, order])
  @@map("slides")
}

model Template {
  id          String       @id @default(cuid())
  type        TemplateType
  name        String
  contentType String?
  variant     String?
  schema      Json
  version     Int          @default(1)
  isActive    Boolean      @default(true)
  createdBy   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([type, contentType, isActive])
  @@map("templates")
}

model SlideGenerationJob {
  id            String   @id @default(cuid())
  slideId       String
  jobType       String // CONTENT | IMAGE_PATH_A | IMAGE_PATH_B | VALIDATION | CLASSIFY | IMAGE_BRIEF
  status        String   @default("PENDING") // PENDING | RUNNING | SUCCEEDED | FAILED
  requestHash   String
  promptVersion String?
  model         String?
  usage         Json?
  visionScore   Float?
  error         String?
  creditCharged Boolean  @default(false)
  latencyMs     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  slide Slide @relation(fields: [slideId], references: [id], onDelete: Cascade)

  @@unique([requestHash])
  @@index([slideId, jobType])
  @@map("slide_generation_jobs")
}

model DeckExport {
  id            String   @id @default(cuid())
  deckId        String
  format        String // PPTX | PDF
  status        String   @default("QUEUED") // QUEUED | RENDERING | READY | FAILED
  s3Key         String?
  error         String?
  creditCharged Boolean  @default(false)
  creditsCharged Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@index([deckId, status])
  @@map("deck_exports")
}

model PresentationImageCache {
  id        String   @id @default(cuid())
  briefHash String   @unique
  s3Key     String
  url       String?
  source    String // stock | ai_gen | path_b
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("presentation_image_cache")
}

model ProductEmailBroadcast {
  id             String   @id @default(uuid())
  subject        String
  htmlBody       String   @map("html_body") @db.Text
  textBody       String?  @map("text_body") @db.Text
  sentByUserId   String   @map("sent_by_user_id")
  recipientCount Int      @map("recipient_count")
  sentCount      Int      @map("sent_count")
  failedCount    Int      @map("failed_count")
  createdAt      DateTime @default(now()) @map("created_at")

  sentBy     User @relation("ProductEmailBroadcastSentBy", fields: [sentByUserId], references: [id], onDelete: Restrict)
  recipients ProductEmailBroadcastRecipient[]

  @@index([createdAt])
  @@index([sentByUserId])
  @@map("product_email_broadcasts")
}

model ProductEmailBroadcastRecipient {
  id          String                               @id @default(uuid())
  broadcastId String                               @map("broadcast_id")
  userId      String                               @map("user_id")
  email       String
  name        String?
  status      ProductEmailBroadcastRecipientStatus
  error       String?
  sentAt      DateTime?                            @map("sent_at")
  createdAt   DateTime                             @default(now()) @map("created_at")

  broadcast ProductEmailBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, userId])
  @@index([broadcastId])
  @@index([userId])
  @@map("product_email_broadcast_recipients")
}
