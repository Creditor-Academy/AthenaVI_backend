generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceType {
  PRIVATE
  TEAM
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum InterfaceMode {
  LIGHT
  DARK
}

enum ThemePalette {
  ORIGINAL
  SAPPHIRE
  OCEAN
  FOREST
  SUNSET
  CUSTOM
}

enum InboxNotificationType {
  WORKSPACE_INVITATION
}

model User {
  id            String  @id @default(uuid())
  email         String  @unique
  name          String?
  password      String?
  profileImage  String? @map("profile_image")
  phoneNumber   String? @map("phone_number")
  emailVerified Boolean @default(false) @map("email_verified")
  storageLimit  Int     @default(1073741824) // 1 GB default limit
  storageUsed   Int     @default(0)

  deletionRequestedAt DateTime? @map("deletion_requested_at")
  deletionScheduledAt DateTime? @map("deletion_scheduled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  accounts            Account[]
  sessions            Session[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  creditTransactions  CreditTransaction[]

  ownedWorkspaces      Workspace[]       @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]

  heygenAvatars HeygenAvatar[]
  heygenVoices  HeygenVoice[]

  settings UserSettings?
  inboxNotifications UserInboxNotification[]

  @@index([deletionScheduledAt])
  @@map("users")
}

model UserSettings {
  id                String         @id @default(uuid())
  userId            String         @unique @map("user_id")
  interfaceMode         InterfaceMode @default(LIGHT) @map("interface_mode")
  themePalette          ThemePalette  @default(SAPPHIRE) @map("theme_palette")
  customAccentColor     String        @default("#2563EB") @map("custom_accent_color")
  pushNotifications     Boolean       @default(true) @map("push_notifications")
  commentsAndMentions   Boolean       @default(true) @map("comments_and_mentions")
  weeklyDigestEmail     Boolean       @default(false) @map("weekly_digest_email")
  productEmails         Boolean       @default(false) @map("product_emails")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_settings")
}

model Workspace {
  id        String        @id @default(uuid())
  name      String
  type      WorkspaceType
  ownerId   String        @map("owner_id")
  credits   Int           @default(0)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  invitations Invitation[]

  folders           Folder[]
  projects          Project[]
  assets            Asset[]
  heygenResponses   HeygenResponse[]
  projectRenders    ProjectRender[]
  sceneRenderCaches SceneRenderCache[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole
  joinedAt    DateTime      @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

model Invitation {
  id          String           @id @default(uuid())
  workspaceId String           @map("workspace_id")
  email       String
  role        WorkspaceRole
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@index([token])
  @@index([expiresAt])
  @@map("invitations")
}

model UserInboxNotification {
  id           String                @id @default(uuid())
  userId       String                @map("user_id")
  type         InboxNotificationType
  title        String
  message      String
  readAt       DateTime?             @map("read_at")
  metadata     Json?
  invitationId String?               @map("invitation_id")
  createdAt    DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, invitationId])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("user_inbox_notifications")
}

model Account {
  id     String @id @default(uuid())
  userId String @map("user_id")

  type              String
  provider          String
  providerAccountId String @map("provider_account_id")

  refreshToken String? @map("refresh_token")
  accessToken  String? @map("access_token")
  expiresAt    Int?    @map("expires_at")
  tokenType    String? @map("token_type")
  scope        String?
  idToken      String? @map("id_token")
  sessionState String? @map("session_state")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expiresAt    DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id          String @id @default(uuid())
  hashedToken String @unique @map("hashed_token")
  userId      String @map("user_id")
  sessionId   String @map("session_id")

  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model CreditTransaction {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  amount      Int
  type        String // purchase | usage | refund | admin_adjustment
  reference   String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([workspaceId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@map("credit_transactions")
}

model Folder {
  id          String    @id @default(uuid())
  name        String
  workspaceId String
  createdBy   String
  updatedBy   String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([name, workspaceId]) // prevent duplicate folder names in same workspace
  @@index([updatedBy])
}

model Project {
  id          String @id @default(uuid())
  name        String
  workspaceId String
  folderId    String
  createdBy   String
  updatedBy   String?

  data          Json // 🔥 whole editor state (autosave)
  thumbnail     String? // preview image
  duration      Int? // optional
  status        String  @default("draft") // draft | rendering | completed
  storageBytes  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id])
  folder            Folder             @relation(fields: [folderId], references: [id])
  heygenResponses   HeygenResponse[]
  projectRenders    ProjectRender[]
  sceneRenderCaches SceneRenderCache[]

  @@index([updatedBy])
}

model Asset {
  id          String @id @default(uuid())
  workspaceId String
  uploadedBy  String

  name String @default("untitled")

  size Int
  type String

  url String
  key String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model HeygenResponse {
  id          String  @id @default(uuid())
  workspaceId String
  folderId    String?
  projectId   String
  sceneId     String  @default("") // client scene key from editor; required on new creates (validated in API)
  videoId     String
  videoUrl    String
  s3Key         String? // S3 object key after upload; used for presigned GET
  fileSizeBytes Int?
  requestHash   String  @unique
  status        String  @default("processing") // processing | completed | failed
  rawResponse   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  project   Project   @relation(fields: [projectId], references: [id])

  @@index([projectId, workspaceId])
}

model ProjectRender {
  id            String    @id @default(uuid())
  workspaceId   String
  folderId      String
  projectId     String
  triggeredBy   String?
  status        String    @default("queued")
  progress      Int       @default(0)
  s3Key         String?
  fileSizeBytes Int?
  outputUrl     String?
  inputSnapshot Json?
  sceneHashes   Json?
  error         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  startedAt     DateTime?
  completedAt   DateTime?
  failedAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, projectId])
  @@map("project_renders")
}

model SceneRenderCache {
  id          String   @id @default(uuid())
  workspaceId String
  folderId    String
  projectId   String
  sceneId     String
  sceneHash   String
  s3Key         String
  fileSizeBytes Int?
  outputUrl     String
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sceneId, sceneHash])
  @@index([workspaceId, projectId])
  @@map("scene_render_caches")
}

model HeygenAvatar {
  id            String  @id @default(uuid())
  userId        String  @map("user_id")
  avatarGroupId String  @map("avatar_group_id")
  avatarId      String? @map("avatar_id")
  name          String?
  type          String
  status        String  @default("processing")
  raw           Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, avatarGroupId])
  @@index([userId])
  @@index([avatarGroupId])
  @@map("heygen_avatars")
}

model HeygenVoice {
  id       String  @id @default(uuid())
  userId   String  @map("user_id")
  voiceId  String  @map("voice_id")
  name     String?
  source   String
  language String?
  raw      Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, voiceId])
  @@index([userId])
  @@index([voiceId])
  @@map("heygen_voices")
}
