generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceType {
  PRIVATE
  TEAM
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum InterfaceMode {
  LIGHT
  DARK
}

enum ThemePalette {
  ORIGINAL
  SAPPHIRE
  OCEAN
  FOREST
  SUNSET
  CUSTOM
}

enum InboxNotificationType {
  WORKSPACE_INVITATION
  WORKSPACE_MEMBER_JOINED
  WORKSPACE_MEMBER_REMOVED
  WORKSPACE_ROLE_CHANGED
  VIDEO_EXPORT_COMPLETED
  VIDEO_EXPORT_FAILED
  CREDITS_PLATFORM_GRANT
  CREDITS_PLATFORM_REVOKE
  CREDITS_WORKSPACE_GRANT
  CREDITS_ALLOCATED
  CREDITS_DEALLOCATED
  CREDITS_LOW_PERSONAL
  CREDITS_LOW_WORKSPACE
  STORAGE_PLATFORM_GRANT
  STORAGE_PLATFORM_REVOKE
  STORAGE_THRESHOLD_WARNING
  STORAGE_UPLOAD_BLOCKED
  PLATFORM_HEYGEN_WALLET_LOW
}

enum StorageUpgradeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String  @id @default(uuid())
  email         String  @unique
  name          String?
  password      String?
  profileImage  String? @map("profile_image")
  phoneNumber   String? @map("phone_number")
  emailVerified Boolean @default(false) @map("email_verified")
  storageLimit  Int     @default(1073741824) // 1 GB default limit
  storageUsed   Int     @default(0)
  credits             Int     @default(0)
  isPlatformSuperadmin Boolean @default(false) @map("is_platform_superadmin")

  deletionRequestedAt DateTime? @map("deletion_requested_at")
  deletionScheduledAt DateTime? @map("deletion_scheduled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  accounts            Account[]
  sessions            Session[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  creditTransactions  CreditTransaction[]
  storageTransactions StorageTransaction[]
  uploadedAssets      Asset[]              @relation("AssetUploader")

  ownedWorkspaces      Workspace[]       @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]

  heygenAvatars HeygenAvatar[]
  heygenVoices  HeygenVoice[]

  settings UserSettings?
  inboxNotifications UserInboxNotification[]
  storageUpgradeRequests StorageUpgradeRequest[]

  @@index([deletionScheduledAt])
  @@map("users")
}

model UserSettings {
  id                String         @id @default(uuid())
  userId            String         @unique @map("user_id")
  interfaceMode         InterfaceMode @default(LIGHT) @map("interface_mode")
  themePalette          ThemePalette  @default(SAPPHIRE) @map("theme_palette")
  customAccentColor     String        @default("#2563EB") @map("custom_accent_color")
  pushNotifications            Boolean @default(true) @map("push_notifications")
  commentsAndMentions          Boolean @default(true) @map("comments_and_mentions")
  weeklyDigestEmail            Boolean @default(false) @map("weekly_digest_email")
  productEmails                Boolean @default(false) @map("product_emails")
  videoExportAlerts            Boolean @default(true) @map("video_export_alerts")
  workspaceVideoExportAlerts   Boolean @default(true) @map("workspace_video_export_alerts")
  creditsAlerts                Boolean @default(true) @map("credits_alerts")
  storageAlerts                Boolean @default(true) @map("storage_alerts")
  workspaceTeamAlerts          Boolean @default(true) @map("workspace_team_alerts")
  platformAdminAlerts          Boolean @default(true) @map("platform_admin_alerts")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_settings")
}

model Workspace {
  id        String        @id @default(uuid())
  name      String
  type      WorkspaceType
  ownerId   String        @map("owner_id")
  credits   Int           @default(0)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  invitations Invitation[]

  folders           Folder[]
  projects          Project[]
  assets            Asset[]
  heygenResponses    HeygenResponse[]
  speechGenerations  SpeechGeneration[]
  projectRenders     ProjectRender[]
  sceneRenderCaches  SceneRenderCache[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole
  joinedAt    DateTime      @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

model Invitation {
  id          String           @id @default(uuid())
  workspaceId String           @map("workspace_id")
  email       String
  role        WorkspaceRole
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@index([token])
  @@index([expiresAt])
  @@map("invitations")
}

model UserInboxNotification {
  id           String                @id @default(uuid())
  userId       String                @map("user_id")
  type         InboxNotificationType
  title        String
  message      String
  readAt       DateTime?             @map("read_at")
  metadata     Json?
  invitationId String?               @map("invitation_id")
  workspaceId  String?               @map("workspace_id")
  referenceId  String?               @map("reference_id")
  createdAt    DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, invitationId])
  @@unique([userId, type, referenceId])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([userId, workspaceId])
  @@map("user_inbox_notifications")
}

model Account {
  id     String @id @default(uuid())
  userId String @map("user_id")

  type              String
  provider          String
  providerAccountId String @map("provider_account_id")

  refreshToken String? @map("refresh_token")
  accessToken  String? @map("access_token")
  expiresAt    Int?    @map("expires_at")
  tokenType    String? @map("token_type")
  scope        String?
  idToken      String? @map("id_token")
  sessionState String? @map("session_state")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expiresAt    DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id          String @id @default(uuid())
  hashedToken String @unique @map("hashed_token")
  userId      String @map("user_id")
  sessionId   String @map("session_id")

  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model CreditTransaction {
  id             String   @id @default(uuid())
  userId         String
  workspaceId    String?
  amount         Int
  type           String // usage | platform_grant | platform_revoke | allocation | deallocation | refund | purchase
  scope          String? // user | workspace
  reference      String?
  idempotencyKey String?  @unique
  metadata       Json?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([workspaceId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@index([scope])
  @@map("credit_transactions")
}

model StorageTransaction {
  id          String   @id @default(uuid())
  userId      String
  amountBytes Int      @map("amount_bytes")
  type        String // initial | platform_grant | platform_revoke | purchase
  tierId      String?  @map("tier_id")
  reference   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type])
  @@map("storage_transactions")
}

model StorageUpgradeRequest {
  id                        String                      @id @default(uuid())
  userId                    String                      @map("user_id")
  requestedAdditionalGb     Int                         @map("requested_additional_gb")
  requestedAdditionalBytes    Int                         @map("requested_additional_bytes")
  reason                    String
  urgency                   String
  currentUsedBytes          Int                         @map("current_used_bytes")
  currentLimitBytes         Int                         @map("current_limit_bytes")
  tierId                    String?                     @map("tier_id")
  tierLabel                 String?                     @map("tier_label")
  workspaceId               String?                     @map("workspace_id")
  workspaceName             String?                     @map("workspace_name")
  workspaceFootprintBytes   Int?                        @map("workspace_footprint_bytes")
  status                    StorageUpgradeRequestStatus @default(PENDING)
  reviewedAt                DateTime?                   @map("reviewed_at")
  reviewedByUserId          String?                     @map("reviewed_by_user_id")
  reviewNote                String?                     @map("review_note")
  createdAt                 DateTime                    @default(now()) @map("created_at")
  updatedAt                 DateTime                    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
  @@map("storage_upgrade_requests")
}

model Folder {
  id          String    @id @default(uuid())
  name        String
  workspaceId String
  createdBy   String
  updatedBy   String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([name, workspaceId]) // prevent duplicate folder names in same workspace
  @@index([updatedBy])
}

model Project {
  id          String @id @default(uuid())
  name        String
  workspaceId String
  folderId    String
  createdBy   String
  updatedBy   String?

  data          Json // 🔥 whole editor state (autosave)
  thumbnail     String? // preview image
  duration      Int? // optional
  status        String  @default("draft") // draft | rendering | completed
  storageBytes  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder            Folder             @relation(fields: [folderId], references: [id], onDelete: Cascade)
  heygenResponses    HeygenResponse[]
  speechGenerations  SpeechGeneration[]
  projectRenders     ProjectRender[]
  sceneRenderCaches  SceneRenderCache[]

  @@index([updatedBy])
}

model Asset {
  id          String @id @default(uuid())
  workspaceId String
  uploadedBy  String

  name String @default("untitled")

  size Int
  type String

  url String
  key String

  source          String @default("upload") // upload | stock
  stockProvider   String?
  stockExternalId String?
  stockMetadata   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploader  User      @relation("AssetUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@unique([workspaceId, stockProvider, stockExternalId])
  @@index([workspaceId, uploadedBy])
}

model HeygenResponse {
  id          String  @id @default(uuid())
  workspaceId String
  folderId    String?
  projectId   String
  sceneId     String  @default("") // client scene key from editor; required on new creates (validated in API)
  videoId     String
  videoUrl    String
  s3Key         String? // S3 object key after upload; used for presigned GET
  fileSizeBytes Int?
  requestHash   String  @unique
  status        String  @default("processing") // processing | completed | failed
  rawResponse   Json?
  triggeredByUserId String? @map("triggered_by_user_id")
  creditsCharged    Int?    @map("credits_charged")
  billedDurationSec Float?  @map("billed_duration_sec")
  billingStatus     String  @default("pending") @map("billing_status") // pending | charged | failed | skipped
  billingContext    Json?   @map("billing_context")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, workspaceId])
}

model SpeechGeneration {
  id                String   @id @default(uuid())
  workspaceId       String
  folderId          String?
  projectId         String
  sceneId           String   @default("")
  voiceId           String
  script            String
  inputType         String   @default("text")
  speed             Float    @default(1)
  locale            String?
  language          String?
  heygenAudioUrl    String?
  audioUrl          String   @default("")
  s3Key             String?
  fileSizeBytes     Int?
  durationSec       Float?
  wordTimestamps    Json?
  requestHash       String   @unique
  status            String   @default("completed")
  rawResponse       Json?
  triggeredByUserId String?  @map("triggered_by_user_id")
  creditsCharged    Int?     @map("credits_charged")
  billedDurationSec Float?   @map("billed_duration_sec")
  billingStatus     String   @default("pending") @map("billing_status")
  billingContext    Json?    @map("billing_context")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, workspaceId])
}

model ProjectRender {
  id            String    @id @default(uuid())
  workspaceId   String
  folderId      String
  projectId     String
  triggeredBy   String?
  status        String    @default("queued")
  progress      Int       @default(0)
  s3Key         String?
  fileSizeBytes Int?
  outputUrl     String?
  inputSnapshot Json?
  sceneHashes   Json?
  error         String?
  creditsCharged    Int?    @map("credits_charged")
  billedDurationSec Float?  @map("billed_duration_sec")
  billingStatus     String  @default("pending") @map("billing_status")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  startedAt     DateTime?
  completedAt   DateTime?
  failedAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, projectId])
  @@index([workspaceId, status, completedAt])
  @@map("project_renders")
}

model SceneRenderCache {
  id          String   @id @default(uuid())
  workspaceId String
  folderId    String
  projectId   String
  sceneId     String
  sceneHash   String
  s3Key         String
  fileSizeBytes Int?
  outputUrl     String
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sceneId, sceneHash])
  @@index([workspaceId, projectId])
  @@map("scene_render_caches")
}

model HeygenAvatar {
  id            String  @id @default(uuid())
  userId        String  @map("user_id")
  avatarGroupId String  @map("avatar_group_id")
  avatarId      String? @map("avatar_id")
  name          String?
  type          String
  status        String  @default("processing")
  raw           Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, avatarGroupId])
  @@index([userId])
  @@index([avatarGroupId])
  @@map("heygen_avatars")
}

model HeygenVoice {
  id       String  @id @default(uuid())
  userId   String  @map("user_id")
  voiceId  String  @map("voice_id")
  name     String?
  source   String
  language String?
  raw      Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, voiceId])
  @@index([userId])
  @@index([voiceId])
  @@map("heygen_voices")
}
