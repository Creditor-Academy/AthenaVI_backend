        {
          "name": "HeyGen videos (project)",
          "description": "Maps to HeyGen `POST /v3/videos`, polls status, stores MP4 in S3. Use **s3-location** for IAM workers (Remotion) or **download** for presigned URLs. Replace `projectId` with a real project in `workspaceId`.",
          "item": [
            {
              "name": "Create avatar video",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "try {",
                      "  const j = pm.response.json();",
                      "  const id = j.data && j.data.heygenVideo && j.data.heygenVideo.id;",
                      "  if (id) { pm.collectionVariables.set('heygenVideoId', id); }",
                      "} catch (e) {}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"sceneId\": \"scene-1\",\n  \"avatarId\": \"replace-with-heygen-avatar-id\",\n  \"title\": \"Scene 1 take\",\n  \"resolution\": \"1080p\",\n  \"aspectRatio\": \"16:9\",\n  \"backgroundColor\": \"#008000\",\n  \"voiceId\": \"replace-with-heygen-voice-id\",\n  \"script\": \"Hello, this is a test line for lip sync.\",\n  \"expressiveness\": \"medium\",\n  \"voiceSettings\": {\n    \"speed\": 1,\n    \"pitch\": 0,\n    \"locale\": \"en-US\"\n  },\n  \"removeBackground\": false,\n  \"outputFormat\": \"mp4\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/projects/{{projectId}}/heygen/videos",
                "description": "201 — Idempotent per (workspace, project, scene, script, avatar, voice). **HEYGEN_API_KEY** and **AWS S3** env must be set for end-to-end flow."
              }
            },
            {
              "name": "List HeyGen videos for project",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/projects/{{projectId}}/heygen/videos"
              }
            },
            {
              "name": "Get HeyGen video (poll + sync to S3)",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/projects/{{projectId}}/heygen/videos/{{heygenVideoId}}",
                "description": "Polls HeyGen until complete (bounded), downloads to S3 when done. May take time while rendering."
              }
            },
            {
              "name": "Get S3 location (IAM / Remotion worker)",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/projects/{{projectId}}/heygen/videos/{{heygenVideoId}}/s3-location",
                "description": "Returns `bucket`, `key`, `region`, `objectArn` for `GetObject` with IAM. No secrets. 409 until file is in S3."
              }
            },
            {
              "name": "Download HeyGen video (presigned URL)",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/projects/{{projectId}}/heygen/videos/{{heygenVideoId}}/download?expiresIn=300",
                "description": "409 if not ready. `presignedUrl` in response is short-lived; call again to refresh. Optional query `expiresIn` seconds: **60–3600** (server default **300** if omitted)."
              }
            },
            {
              "name": "Stream HeyGen video (stable preview URL)",
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
                },
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/projects/{{projectId}}/heygen/videos/{{heygenVideoId}}/stream",
                "description": "Pipes S3 through API; same path does not expire like presigned URLs. Use `fetch` + blob `src` for `<video>` (native `src` cannot send Bearer). Optional `Range` header for seeking."
              }
            }
          ]
