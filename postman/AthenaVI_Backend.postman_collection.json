    {
      "name": "HeyGen",
      "description": "HeyGen v3 proxy (`/api/heygen`). One shared HeyGen API key: **`ownership=private`** (avatars) and **`type=private`** (voices) trigger **server-side filtering** of the HeyGen JSON (supports nested list envelopes such as `data.data`, `avatar_group_list`, `looks`, `voices`, `suggestions`, etc.) so each JWT user only sees rows recorded for them in **`heygen_avatars`** / **`heygen_voices`**. Public lists are unchanged passthrough.\n\n**403** (`You do not have access to this HeyGen resource`) — avatar consent for another user's group, GET voice by id for another user's **stored** private voice, or **private** looks with another user's `group_id`.",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "List avatar groups (public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/heygen/avatars/groups?ownership=public&limit=20",
            "description": "Forwarded to HeyGen; full public catalog (not user-filtered)."
          }
        },
        {
          "name": "List avatar groups (private — current user)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/heygen/avatars/groups?ownership=private&limit=20",
            "description": "Only avatar groups recorded when **you** called POST `/avatars` (same Bearer user). The backend filters HeyGen's payload locally (including nested `data` / `avatar_group_list`-style lists). Assets created before ownership tracking or outside this API are omitted."
          }
        },
        {
          "name": "List avatar looks (public group)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/heygen/avatars/looks?group_id={{groupId}}&avatar_type=studio_avatar&limit=20",
            "description": "Set `groupId` (collection variable) from a public catalog group when exploring looks."
          }
        },
        {
          "name": "List avatar looks (private — current user)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/heygen/avatars/looks?ownership=private&limit=20",
            "description": "Filtered to looks whose avatar **group_id** belongs to you (server strips other tenants' rows from HeyGen's response, including lists nested under `data`). Omit `group_id` for all your looks; add `group_id` + private only for **your** group — otherwise **403**."
          }
        },
        {
          "name": "Create avatar",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "try {",
                  "  const j = pm.response.json();",
                  "  const outer = j.data;",
                  "  const chain = [];",
                  "  let cur = outer && typeof outer === 'object' && outer.data !== undefined ? outer.data : outer;",
                  "  for (let i = 0; i < 6 && cur && typeof cur === 'object' && !Array.isArray(cur); i++) {",
                  "    chain.push(cur);",
                  "    const next = cur.data;",
                  "    if (next && typeof next === 'object' && !Array.isArray(next)) cur = next;",
                  "    else break;",
                  "  }",
                  "  function gidFrom(o) {",
                  "    if (!o || typeof o !== 'object') return null;",
                  "    const ag = o.avatar_group;",
                  "    return (o.avatar_group_id || o.group_id || o.avatarGroupId || o.groupId ||",
                  "      (ag && typeof ag === 'object' && (ag.avatar_group_id || ag.group_id || ag.id)) || null);",
                  "  }",
                  "  let gid = null;",
                  "  for (const n of chain) { gid = gidFrom(n); if (gid) break; }",
                  "  if (!gid) for (const n of chain) { if (n.id) { gid = n.id; break; } }",
                  "  if (gid) pm.collectionVariables.set('groupId', String(gid));",
                  "} catch (e) {}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"prompt\",\n  \"name\": \"My Avatar\",\n  \"prompt\": \"A professional instructor in a studio\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/heygen/avatars",
            "description": "Registers the returned avatar group for your user (for private list filtering). Test script saves `groupId` when HeyGen returns an id."
          }
        },
        {
          "name": "Create avatar (multipart photo or digital twin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "try {",
                  "  const j = pm.response.json();",
                  "  const outer = j.data;",
                  "  const chain = [];",
                  "  let cur = outer && typeof outer === 'object' && outer.data !== undefined ? outer.data : outer;",
                  "  for (let i = 0; i < 6 && cur && typeof cur === 'object' && !Array.isArray(cur); i++) {",
                  "    chain.push(cur);",
                  "    const next = cur.data;",
                  "    if (next && typeof next === 'object' && !Array.isArray(next)) cur = next;",
                  "    else break;",
                  "  }",
                  "  function gidFrom(o) {",
                  "    if (!o || typeof o !== 'object') return null;",
                  "    const ag = o.avatar_group;",
                  "    return (o.avatar_group_id || o.group_id || o.avatarGroupId || o.groupId ||",
                  "      (ag && typeof ag === 'object' && (ag.avatar_group_id || ag.group_id || ag.id)) || null);",
                  "  }",
                  "  let gid = null;",
                  "  for (const n of chain) { gid = gidFrom(n); if (gid) break; }",
                  "  if (!gid) for (const n of chain) { if (n.id) { gid = n.id; break; } }",
                  "  if (gid) pm.collectionVariables.set('groupId', String(gid));",
                  "} catch (e) {}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "type", "value": "photo", "type": "text" },
                { "key": "name", "value": "My photo avatar", "type": "text" },
                { "key": "file", "type": "file", "src": [] }
              ]
            },
            "url": "{{baseUrl}}/api/heygen/avatars",
            "description": "Use **photo** + image file (JPEG/PNG/WebP), or **digital_twin** + image or MP4/WebM. Field name must be **file**. Same nested-response `groupId` test script as JSON Create avatar. Max 32 MB."
          }
        },
        {
          "name": "Create avatar consent",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
