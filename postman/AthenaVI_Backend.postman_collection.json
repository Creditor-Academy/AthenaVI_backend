        },
        {
          "name": "List voices (private — current user)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/heygen/voices?type=private&limit=50",
            "description": "Only voices recorded when **you** called POST `/voices` (design) or POST `/voices/clone`. Backend filters HeyGen's JSON locally (`voices`, `suggestions`, nested `data`, etc.)."
          }
        },
        {
          "name": "Design a voice (POST /v3/voices)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "try {",
                  "  const j = pm.response.json();",
                  "  const outer = j.data;",
                  "  const d = outer && typeof outer === 'object' && outer.data !== undefined ? outer.data : outer;",
                  "  const firstId = (row) => (row && (row.voice_id || row.id)) || null;",
                  "  const fromArr = (arr) => (Array.isArray(arr) && arr[0] ? firstId(arr[0]) : null);",
                  "  let vid = d && d.voice_id;",
                  "  if (!vid && Array.isArray(d)) vid = fromArr(d);",
                  "  if (!vid && d) {",
                  "    vid = fromArr(d.voices) || fromArr(d.suggestions) || fromArr(d.voice_list)",
                  "      || fromArr(d.list) || fromArr(d.items) || fromArr(d.results) || fromArr(d.data);",
                  "  }",
                  "  if (vid) pm.collectionVariables.set('voiceId', String(vid));",
                  "} catch (e) {}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Warm, confident female narrator for e-learning\",\n  \"gender\": \"female\",\n  \"seed\": 0\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/heygen/voices",
            "description": "HeyGen `POST /v3/voices` — up to 3 suggested voices. Server records returned voice ids (matches nested HeyGen shapes: `voices`, `suggestions`, `data`, …). Same path as list voices; method is POST. Test script saves first resolved `voiceId`."
          }
        },
        {
