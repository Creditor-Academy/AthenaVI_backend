                  "  const firstId = (row) => (row && (row.voice_id || row.id)) || null;",
                  "  const fromArr = (arr) => (Array.isArray(arr) && arr[0] ? firstId(arr[0]) : null);",
                  "  let vid = d && (d.voice_id || d.id);",
                  "  if (!vid && Array.isArray(d)) vid = fromArr(d);",
                  "  if (!vid && d) {",
                  "    vid = fromArr(d.voices) || fromArr(d.suggestions) || fromArr(d.voice_list)",
                  "      || fromArr(d.list) || fromArr(d.items) || fromArr(d.results) || fromArr(d.data);",
                  "  }",
                  "  if (vid) pm.collectionVariables.set('voiceId', String(vid));",
                  "} catch (e) {}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"voice_name\": \"My cloned voice\",\n  \"audio\": {\n    \"type\": \"asset_id\",\n    \"asset_id\": \"REPLACE_WITH_ASSET_ID_FROM_UPLOAD\"\n  },\n  \"remove_background_noise\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/heygen/voices/clone",
            "description": "HeyGen `POST /v3/voices/clone`. Records clone voice id for your user. Poll **Get voice by id** until complete. Test script saves `voiceId` when present."
          }
        },
