# Copy to .env.development for local dev. On Render, set these in the service Environment tab.

PORT=9000
NODE_ENV=development

DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-string
SALT_ROUNDS=10

BACKEND_URL=http://localhost:9000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: Web Fonts Developer API key for live Google Fonts catalog merge
# (catalog works without it via vendored snapshot)
# GOOGLE_FONTS_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

HEYGEN_API_KEY=
HEYGEN_BILLING_MODE=payg

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Email branding (optional)
# EMAIL_BRAND_NAME=Virtual Studio
# EMAIL_LOGO_URL=https://testing-vi.s3.us-east-1.amazonaws.com/Copilot_20260703_145052.png
# EMAIL_EXPLORE_URL=https://virtualstudio.lmsathena.com/products

PLATFORM_SUPERADMIN_EMAILS=you@yourcompany.com
# PLATFORM_SUPERADMIN_NOTIFICATION_EMAIL=ops@yourcompany.com

# Early access form (optional rate limits; defaults: 3 requests / IP / hour)
# EARLY_ACCESS_RATE_LIMIT_MAX=3
# EARLY_ACCESS_RATE_LIMIT_WINDOW_SEC=3600

# Optional
JSON_BODY_LIMIT=32mb
TRUST_PROXY_HOPS=1
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=

# AI PPT / Presentation (OpenAI) — required for deck generation
OPENAI_API_KEY=
# PPT_OUTLINE_MODEL=gpt-4.1
# PPT_SLIDE_MODEL=gpt-4.1-mini
# PPT_IMAGE_MODEL=gpt-image-1
# PPT_VISION_MODEL=gpt-4.1-mini
# PPT_SLIDE_CONCURRENCY=4
# PPT_GENERATE_RATE_LIMIT_MAX=10
# PPT_GENERATE_RATE_LIMIT_WINDOW_SEC=3600
# PPT_REGENERATE_RATE_LIMIT_MAX=30
# PPT_REGENERATE_RATE_LIMIT_WINDOW_SEC=3600
